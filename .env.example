# Copy to .env and fill in. .env is gitignored; this template is not, so it must
# never contain a real key.

# development | staging | production | test
APP_ENV=development

# --- chat model -----------------------------------------------------------------
# Any OpenAI-compatible endpoint. Because screening quality is what the project is
# for, reserve model downgrades for stages where a mistake is recoverable.
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_MAX_TOKENS=1024
# 0 by design: screening has to be reproducible, and a run that scores differently
# each time cannot be audited.
LLM_TEMPERATURE=0

# --- embeddings -----------------------------------------------------------------
# DeepSeek serves no embedding endpoint, so this is usually a different vendor.
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMENSIONS=1024
# Aliyun MaaS rejects more than 10 inputs per request. The client also splits
# defensively, so raising this costs extra round trips rather than failing.
EMBEDDING_BATCH_SIZE=10

# --- database -------------------------------------------------------------------
# A real Postgres DSN. SUPABASE_URL is accepted as a fallback because this
# project's .env historically stored one there, and a local SQLite file is the
# last resort so a fresh clone runs with no credentials at all.
DATABASE_URL=
SUPABASE_URL=

# --- reranking ------------------------------------------------------------------
# A cross-encoder between embedding recall and judgement. Optional: when the
# endpoint is unreachable the stage logs and the recall order stands, because
# reranking refines candidates that were already selected.
RERANK_ENABLED=true
RERANK_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
RERANK_API_KEY=
RERANK_MODEL=gte-rerank-v2

# --- funnel knobs ---------------------------------------------------------------
# Candidates per judge call. The single largest token lever: the shared prompt is
# billed once per call, so 5 amortises it five ways.
SCREEN_BATCH_SIZE=5
SCREEN_SHORTLIST_SIZE=25
# Deliberately wider than the shortlist — bi-encoder ordering near the cut is close
# to arbitrary, so the reranker needs candidates to actually reorder.
SCREEN_RECALL_POOL_SIZE=50
SCREEN_RECALL_TOP_CHUNKS=3
# Half-width in score points around the pass line that gets a full-text second look.
# Narrowing this to zero silently disables stage 4.
SCREEN_BORDERLINE_BAND=8
# Share of required skills below which stage 1 drops a candidate outright. 0 means
# only a complete miss rejects. Raising it saves embedding and risks recall.
SCREEN_RULE_MIN_REQUIRED_SHARE=0

# --- price table ----------------------------------------------------------------
# Token counts are measured; money is derived from these and they change without
# notice. Verify against current pricing before quoting a figure.
PRICE_LLM_INPUT=2.0
PRICE_LLM_CACHED_INPUT=0.5
PRICE_LLM_OUTPUT=8.0
PRICE_EMBEDDING_INPUT=0.5
PRICE_RERANK_INPUT=0.8
